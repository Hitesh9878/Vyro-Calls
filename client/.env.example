# Only needed when the client is NOT served behind the dev proxy
# (e.g. production, where the API lives on a different origin).
# VITE_API_URL=https://api.example.com/api
# VITE_SERVER_URL=https://api.example.com

# Optional TURN server. Needed for calls between users behind strict NATs / mobile networks.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=username
# VITE_TURN_PASS=password
